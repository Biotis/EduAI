# GCP 프로젝트 및 인증
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Document AI
DOC_AI_LOCATION=us
DOC_AI_PROCESSOR_ID=your-processor-id
DOC_AI_GCS_BUCKET=your-bucket-name
DOC_AI_GCS_PREFIX=docai

# PPT -> PDF 변환용 LibreOffice 실행 파일 경로
# 로컬(Windows) 예: C:\Program Files\LibreOffice\program\soffice.exe
# 컨테이너(Linux): /usr/bin/soffice
LIBREOFFICE_PATH=/usr/bin/soffice

# CORS 허용 오리진 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:3000
